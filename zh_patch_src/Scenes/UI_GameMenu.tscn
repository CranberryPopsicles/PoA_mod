[node name="Background" parent="Windows/Controls" instance=ExtResource( 15 )]

[node name="RichTextLabel" type="RichTextLabel" parent="Windows/Controls"]
margin_left = 89.0
margin_top = 38.0
margin_right = 554.0
margin_bottom = 503.0
line_spacing = 2
	fit_content = true
bbcode_enabled = true
bbcode_text = "[color=#c0c0c0][center]控制


[color=#ffff00]tab[/color] / [color=#ffff00]右键[/color] / [color=#ffff00]小键盘 0[/color]
\"自动行动\"
自动攻击已选目标，向范围内最近的敌人移动，拾取最近物品，前往出口，穿过出口
也可在多数菜单中循环选择，或随机生成角色

[color=#ffff00]alt[/color]
切换目标，目标必须在攻击范围内


[color=#ffff00]空格[/color] / [color=#ffff00]鼠标中键[/color]
原地等待


[color=#ffff00]enter[/color]
穿过出口，进入新地域，确认死亡，开始游戏

[color=#ffff00]1, 2 and 3[/color]
诵念第 1、第 2 或第 3 个祈祷，若可用


[color=#ffff00]小键盘
7/q/y   8/w/k   9/e/u

4/a/h   5/s/.   6/d/l

1/z/b   2/x/j   3/c/n[/color]
向对应方向移动，或对相邻方向的敌人发动初始攻击
[color=#ffff00]5[/color] 或 [color=#ffff00]s[/color]（\"中间方向\"）原地等待[/center]

"
text = "控制


tab / 右键 / 小键盘 0
\"自动行动\"
自动攻击已选目标，向范围内最近的敌人移动，拾取最近物品，前往出口，穿过出口
也可在多数菜单中循环选择，或随机生成角色

alt
切换目标，目标必须在攻击范围内


空格 / 鼠标中键
原地等待


enter
穿过出口，进入新地域，确认死亡，开始游戏

1, 2 和 3
诵念第 1、第 2 或第 3 个祈祷，若可用


小键盘
7/q/y   8/w/k   9/e/u

4/a/h   5/s/.   6/d/l

1/z/b   2/x/j   3/c/n
向对应方向移动，或对相邻方向的敌人发动初始攻击
5 或 s（\"中间方向\"）原地等待

"
__meta__ = {
"_edit_use_anchors_": false
}

[node name="Guide" type="ColorRect" parent="Windows"]
visible = false
margin_left = 105.0
margin_top = -22.0
margin_right = 736.0
margin_bottom = 451.0
color = Color( 0, 0, 0, 1 )

[node name="Background" parent="Windows/Guide" instance=ExtResource( 15 )]
script = SubResource( 66 )

[node name="RichTextLabel" type="RichTextLabel" parent="Windows/Guide"]
margin_left = 60.0
margin_top = 5.0
margin_right = 621.0
margin_bottom = 533.0
line_spacing = 2
	fit_content = true
bbcode_enabled = true
bbcode_text = "[color=#c0c0c0][center]指南[/center]


[color=#a0a0a0]目标是抵达每层的出口。你可以攻击并杀死敌人，但这不是必需的。击杀敌人和进入新楼层会获得[color=#ffff50]荣耀[/color]。每个区域的最后一层会出现一件或多件[color=#ffff50]物品[/color]，它们能大幅提升你的能力

点击 [img]res://Ham_Sprite/UI/Powers.png[/img] 消耗点数学习新能力 -- 每次荣耀提升都会获得 +1 点
点击 [img]res://Ham_Sprite/UI/Inventory.png[/img] 查看背包并装备新物品。这里也会显示你的属性，并说明它们的机制。[color=#50ff50]速度[/color]非常重要 -- 它决定你相对敌人的行动频率 -- 也会被物品的负重与僵硬降低


要构建强力角色，尽量选择能彼此配合的能力和装备。除了[color=#78bca4]祈祷[/color]之外，没有主动技能 -- 一切都会由特定事件触发 -- 例如\"移动时\"、\"造成火焰伤害时\"等


\"[color=#ffff50]攻击时[/color]\"：当你发动任何形式的攻击。\"初始攻击\"特指每件武器执行的第一次基础攻击，有时会生成\"额外攻击\"，例如 Swift Blade

\"[color=#ffff50]命中时[/color]\"：攻击命中并造成伤害。某些能力也会生成免费命中，例如 Guard 和 Projection

\"[color=#ffff50]造成伤害时[/color]\"：指你以任意方式造成的伤害

\"[color=#ffff50]进入时[/color]\"：当你首次进入新楼层

\"[color=#ffff50]祈祷时[/color]\"：当你点击屏幕顶部的[color=#78bca4]祈祷[/color]之一。随着荣耀提升会出现新的祈祷，其充能恢复方式取决于祈祷本身和你的信仰

\"[color=#ffff50]卸开时[/color]\"：当你用护甲阻止一次命中


这些是构建角色时需要注意的一部分触发条件，还有更多机制可供尝试，并且可以形成复杂的连锁反应。祝你玩得开心！


"
text = "指南


目标是抵达每层的出口。你可以攻击并杀死敌人，但这不是必需的。击杀敌人和进入新楼层会获得荣耀。每个区域的最后一层会出现一件或多件物品，它们能大幅提升你的能力

点击  消耗点数学习新能力 -- 每次荣耀提升都会获得 +1 点
点击  查看背包并装备新物品。这里也会显示你的属性，并说明它们的机制。速度非常重要 -- 它决定你相对敌人的行动频率 -- 也会被物品的负重与僵硬降低


要构建强力角色，尽量选择能彼此配合的能力和装备。除了祈祷之外，没有主动技能 -- 一切都会由特定事件触发 -- 例如\"移动时\"、\"造成火焰伤害时\"等


\"攻击时\"：当你发动任何形式的攻击。\"初始攻击\"特指每件武器执行的第一次基础攻击，有时会生成\"额外攻击\"，例如 Swift Blade

\"命中时\"：攻击命中并造成伤害。某些能力也会生成免费命中，例如 Guard 和 Projection

\"造成伤害时\"：指你以任意方式造成的伤害

\"进入时\"：当你首次进入新楼层

\"祈祷时\"：当你点击屏幕顶部的祈祷之一。随着荣耀提升会出现新的祈祷，其充能恢复方式取决于祈祷本身和你的信仰

\"卸开时\"：当你用护甲阻止一次命中


这些是构建角色时需要注意的一部分触发条件，还有更多机制可供尝试，并且可以形成复杂的连锁反应。祝你玩得开心！


"
