[sub_resource type="GDScript" id=66]
script/source = "extends ColorRect


func _process(delta):
	if ToolSettings.settings_data.has(\"background_color\"):
		match ToolSettings.settings_data.background_color:
			\"black\":
				color = Color(0,0,0,1)
				#color = Color(.1,.05,0,1)
			\"brown\":
				color = Color(.1,.05,0,1)
			\"green\":
				color = Color(0,.1,.05,1)
			\"blue\":
				color = Color(.05,0,.1,1)
			\"grey\":
				color = Color(.15,.15,.15,1)
			\"red\":
				color = Color(.15,.05,.05,1)
"

